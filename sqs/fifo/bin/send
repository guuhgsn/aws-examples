#!/usr/bin/env bash
echo "== send" # exibe na tela o que faz o script

root_path=$(realpath .) # caminho absoluto do diretorio atual
message_attributes_path="file://${root_path}/send-message.json" # define o caminho onde a mensagem deve ser consultada

QUEUE_URL=https://sqs.ca-central-1.amazonaws.com/982383527471/sqs-fifo-MyQueue-TFdtzZeh3R0e.fifo # salva a URL da fila em uma variavel

# https://awscli.amazonaws.com/v2/documentation/api/latest/reference/sqs/send-message.html
aws sqs send-message \
--queue-url $QUEUE_URL \
--message-body "Hello 1!" \
--message-deduplication-id 1 \
--message-group-id "hello" \
--message-attributes $message_attributes_path

aws sqs send-message \
--queue-url $QUEUE_URL \
--message-body "Hello 2!" \
--message-deduplication-id 2 \
--message-group-id "hello" \
--message-attributes $message_attributes_path

aws sqs send-message \
--queue-url $QUEUE_URL \
--message-deduplication-id 3 \
--message-body "Hello 3!" \
--message-group-id "hello" \
--message-attributes $message_attributes_path

aws sqs send-message \
--queue-url $QUEUE_URL \
--message-deduplication-id 4 \
--message-body "Hello 4!" \
--message-group-id "hello" \
--message-attributes $message_attributes_path

aws sqs send-message \
--queue-url $QUEUE_URL \
--message-deduplication-id 5 \
--message-body "Hello 5!" \
--message-group-id "hello" \
--message-attributes $message_attributes_path

# aws sqs send-message - chama a opcao de envio de mensagem no SQS
# --queue-url $QUEUE_URL - usa o valor da variavel para definir a URL
# --message-deduplication-id 5 - token para evitar duplicatas
# --message-body "Hello 5!" - corpo da mensagem que sera enviada
# --message-group-id "hello" - organiza as mensagens em grupos distintos
# --message-attributes $message_attributes_path - o caminho para o arquivo com os atributos da mensagem