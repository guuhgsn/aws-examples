#!/usr/bin/env bash
echo "== receive" # exibe na tela o que faz o script

root_path=$(realpath .) # caminho absoluto do diretorio atual

QUEUE_URL=https://sqs.ca-central-1.amazonaws.com/982383527471/sqs-standard-MyQueue-ONKfvvgwWJo2 # salva a URL da fila em uma variavel

# https://docs.aws.amazon.com/cli/latest/reference/sqs/receive-message.html
aws sqs receive-message \
--queue-url $QUEUE_URL \
--attribute-names All \
--message-attribute-names All  \
--max-number-of-messages 10

# aws sqs receive-message - chama a opcao de recebimento de mensagem no SQS
# --queue-url $QUEUE_URL - usa o valor da variavel para definir a URL
# --attribute-names All - retorna todos os valores da mensagem
# --message-attribute-names All - retorna toda a lista de atributos da mensagem
# --max-number-of-messages 10 - numero maximo de mensagens retornadas